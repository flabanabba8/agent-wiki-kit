{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mem0-hot": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "cd \"$(git rev-parse --show-toplevel)\" && exec ./.venv/bin/python scripts/mem0/mcp_server.py"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "camoufox": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "cd \"$(git rev-parse --show-toplevel)\" && exec ./.venv/bin/python scripts/camoufox/mcp_server.py"
      ],
      "enabled": true,
      "timeout": 60000
    }
  },
  "permission": {
    "skill": {
      "*": "allow",
      "autoresearch": "ask",
      "wiki-lint": "ask"
    }
  }
}
